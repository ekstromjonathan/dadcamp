---
import { venue, event } from "../data/content";
---

<section id="sted" class="bg-cream border-t border-forest/10">

  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 pb-2 flex items-center gap-4">
    <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-forest/40">04 — Sted</span>
    <div class="flex-1 h-px bg-forest/10"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24 grid md:grid-cols-12 gap-12 items-start">

    <!-- Info -->
    <div class="md:col-span-4">
      <h2 class="text-[clamp(1.8rem,3.5vw,2.8rem)] font-light tracking-tight text-forest leading-tight mb-6">
        {venue.name}
      </h2>

      <div class="border-t border-forest/15">
        <div class="py-4 border-b border-forest/10">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-forest/35 mb-1">Adresse</p>
          <p class="text-sm text-forest/80">{venue.address}</p>
        </div>
        <div class="py-4 border-b border-forest/10">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-forest/35 mb-1">Dato</p>
          <p class="text-sm text-forest/80">{event.dates}</p>
        </div>
        <div class="py-4 border-b border-forest/10">
          <p class="text-[10px] font-bold tracking-[0.2em] uppercase text-forest/35 mb-1">Oppmøte</p>
          <p class="text-sm text-forest/80">{venue.meetingPoint}</p>
        </div>
        <div class="py-4">
          <a
            href={venue.mapsUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-block text-[11px] font-bold tracking-[0.18em] uppercase border border-forest px-5 py-3 text-forest hover:bg-forest hover:text-cream transition-colors"
          >
            Åpne i Google Maps →
          </a>
        </div>
      </div>
    </div>

    <!-- Map — Leaflet with CartoDB Positron tiles -->
    <div class="md:col-span-8 overflow-hidden h-72 md:h-[480px]" id="venue-map"></div>

  </div>
</section>

<script is:inline>
(function () {
  // Load Leaflet CSS
  var css = document.createElement('link');
  css.rel = 'stylesheet';
  css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
  document.head.appendChild(css);

  // Load Leaflet JS, then init map
  var js = document.createElement('script');
  js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
  js.onload = function () {
    var map = L.map('venue-map', { zoomControl: true, scrollWheelZoom: false }).setView([59.224, 10.292], 13);

    L.tileLayer('https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png', {
      attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/">CARTO</a>',
      maxZoom: 19,
    }).addTo(map);

    var icon = L.divIcon({
      html: '<div style="width:12px;height:12px;background:#1a2e1a;border-radius:50%;border:3px solid white;box-shadow:0 2px 8px rgba(0,0,0,0.25);"></div>',
      iconSize: [12, 12],
      iconAnchor: [6, 6],
      className: '',
    });

    L.marker([59.224, 10.292], { icon }).addTo(map);
  };
  document.head.appendChild(js);
})();
</script>
