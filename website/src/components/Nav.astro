---
import { nav, spond } from "../data/content";
---

<header id="site-nav" class="fixed top-0 left-0 right-0 z-50 transition-all duration-300 bg-transparent" data-nav>
  <div class="max-w-7xl mx-auto px-6 md:px-10">
    <div class="flex items-center justify-between h-16 md:h-20 border-b border-white/10 transition-colors duration-300" data-nav-inner>

      <!-- Logo (white/inverted over hero, dark after scroll) -->
      <a href="/" class="flex-shrink-0 w-36 md:w-48 group" aria-label="DADCAMP">
        <img
          src="/images/logos/logo-horizontal.svg"
          alt="DADCAMP"
          class="w-full h-auto logo-light transition-all duration-300 group-hover:opacity-60"
          data-nav-logo
        />
      </a>

      <!-- Links -->
      <nav class="hidden md:flex items-center gap-10" aria-label="Navigasjon">
        {nav.slice(0, -1).map((link) => (
          <a
            href={link.href}
            class="text-[11px] font-bold tracking-[0.18em] uppercase text-white transition-all duration-300 hover:opacity-50"
            data-nav-link
          >
            {link.label}
          </a>
        ))}
      </nav>

      <!-- CTA -->
      <a
        href={spond.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[11px] font-bold tracking-[0.18em] uppercase px-5 py-2.5 border-2 border-white text-white transition-all duration-300 hover:opacity-60"
        data-nav-cta
      >
        Bli med →
      </a>
    </div>
  </div>
</header>

<script>
  const navEl = document.getElementById('site-nav') as HTMLElement;
  const inner = navEl.querySelector('[data-nav-inner]') as HTMLElement;
  const logo  = navEl.querySelector('[data-nav-logo]') as HTMLImageElement;
  const links = navEl.querySelectorAll('[data-nav-link]') as NodeListOf<HTMLElement>;
  const cta   = navEl.querySelector('[data-nav-cta]') as HTMLElement;

  function update() {
    const scrolled = window.scrollY > 80;

    navEl.style.background = scrolled ? 'rgba(245,240,232,0.97)' : 'transparent';
    inner.style.borderColor = scrolled ? 'rgba(26,46,26,0.1)' : 'rgba(255,255,255,0.1)';

    logo.classList.toggle('logo-light', !scrolled);

    links.forEach(l => {
      l.style.color = scrolled ? '#1a2e1a' : '#fff';
    });

    if (scrolled) {
      cta.style.borderColor = '#1a2e1a';
      cta.style.color       = '#1a2e1a';
    } else {
      cta.style.borderColor = '#fff';
      cta.style.color       = '#fff';
    }
  }

  update();
  window.addEventListener('scroll', update, { passive: true });
</script>
