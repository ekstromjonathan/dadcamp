---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { contact, event, venue } from "../data/content";
---

<Layout title="Bli med" description={contact.intro}>
  <Nav />

  <main class="relative min-h-screen overflow-hidden bg-pine pb-24 pt-36 text-cream md:pt-44">
    <div class="pointer-events-none absolute inset-0 glow-ember" aria-hidden="true"></div>

    <div class="shell relative">
      <div class="max-w-2xl">
        <p class="chip chip-dark">
          <span class="text-amber/80">{event.dateShort} 2026</span>
          {event.location}
        </p>

        <h1
          class="mt-8 text-[clamp(2.4rem,6vw,4.5rem)] font-medium leading-[1.03] tracking-tight text-cream"
        >
          {contact.heading}
        </h1>

        <p class="mt-6 max-w-lg text-base leading-relaxed text-white/55 md:text-lg">
          {contact.intro}
        </p>

        <a
          href={contact.spondUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-primary mt-11 !px-9 !py-4"
        >
          <img
            src="/images/logos/icon.svg"
            alt=""
            class="logo-light h-5 w-5 opacity-70"
            aria-hidden="true"
          />
          Bli med i Spond <span class="arrow">→</span>
        </a>

        <!-- Quick facts -->
        <dl class="mt-14 grid gap-3 sm:grid-cols-3">
          {
            [
              { label: "Dato", value: event.dates },
              { label: "Sted", value: venue.name },
              { label: "Oppmøte", value: venue.meetingPoint },
            ].map((row) => (
              <div class="card-dark !p-5">
                <dt class="text-[10px] font-semibold uppercase tracking-label text-white/35">
                  {row.label}
                </dt>
                <dd class="mt-2 text-sm text-white/85">{row.value}</dd>
              </div>
            ))
          }
        </dl>

        <p class="mt-10 max-w-lg border-t border-white/10 pt-8 text-xs leading-relaxed text-white/35">
          Spond er gratis å bruke. Der finner du all informasjon om oppmøtested, praktiske
          detaljer og oppdateringer frem mot helgen. Du kan også lese mer om muligheten for å
          bli betalende støttemedlem.
        </p>

        <a
          href="/"
          class="mt-12 inline-block text-[10px] font-semibold uppercase tracking-label text-white/30 transition-colors duration-300 hover:text-white/70"
        >
          ← Tilbake
        </a>
      </div>
    </div>
  </main>

  <Footer />
</Layout>
