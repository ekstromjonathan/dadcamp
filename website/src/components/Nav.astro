---
import { nav, event } from "../data/content";
---

<header class="fixed top-0 left-0 right-0 z-50 mix-blend-multiply">
  <nav class="max-w-6xl mx-auto px-6 py-5 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 group">
      <img src="/images/logo.svg" alt="DADCAMP" class="h-8 w-auto" />
      <span class="font-display font-black text-lg tracking-tight text-forest hidden sm:block">
        DADCAMP
      </span>
    </a>

    <ul class="hidden md:flex items-center gap-8">
      {nav.slice(0, -1).map((link) => (
        <li>
          <a
            href={link.href}
            class="text-sm font-medium text-forest/70 hover:text-forest transition-colors"
          >
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <a
      href={event.contactUrl}
      class="bg-forest text-cream px-5 py-2.5 rounded-full text-sm font-semibold hover:bg-moss transition-colors"
    >
      Bli med →
    </a>
  </nav>
</header>
