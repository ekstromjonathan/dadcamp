---
import { spond, event } from "../data/content";
---

<!-- Spond CTA — the most important action on the page -->
<section class="bg-ember text-white">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-20">
    <div class="grid md:grid-cols-12 items-center gap-10">

      <!-- DADCAMP icon as watermark -->
      <div class="hidden md:block md:col-span-1 opacity-20">
        <img src="/images/logos/icon.svg" alt="" class="w-full logo-light" aria-hidden="true" />
      </div>

      <!-- Text -->
      <div class="md:col-span-7">
        <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-white/60 mb-3">
          All kommunikasjon skjer her
        </p>
        <h2 class="text-[clamp(1.5rem,4vw,2.5rem)] font-light leading-tight tracking-tight">
          Bli med i{" "}
          <span class="font-bold">Spond-gruppa</span>{" "}
          — der finner du alt om oppmøtested, oppdateringer og fellesskapet.
        </h2>
      </div>

      <!-- CTA -->
      <div class="md:col-span-4 flex md:justify-end">
        <a
          href={spond.url}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-4 bg-white text-ember px-8 py-5 font-bold text-[11px] tracking-[0.2em] uppercase hover:bg-cream transition-colors"
        >
          <span>Bli med i Spond</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>
      </div>

    </div>
  </div>
</section>
