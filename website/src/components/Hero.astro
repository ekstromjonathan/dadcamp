---
import { event, spond } from "../data/content";
---

<section class="relative h-screen min-h-[600px] flex flex-col overflow-hidden bg-forest">

  <!-- Video background -->
  <div class="absolute inset-0">
    <video
      id="hero-video"
      class="w-full h-full object-cover"
      autoplay
      muted
      loop
      playsinline
      poster="/images/bonfire.png"
      preload="auto"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
      <source src="/video/hero.webm" type="video/webm" />
    </video>
    <script>
      const video = document.getElementById('hero-video');
      if (video) {
        // Safari bug: muted attribute must also be set via JS
        video.muted = true;
        video.play().catch(() => {});
        // Safari sometimes ignores the loop attribute — force loop manually
        video.addEventListener('ended', () => {
          video.currentTime = 0;
          video.play().catch(() => {});
        });
      }
    </script>
    <!-- Dark overlay — heavier at top and bottom, lighter in middle -->
    <div class="absolute inset-0 bg-gradient-to-b from-forest/70 via-forest/20 to-forest/85"></div>
  </div>

  <!-- Top edge: LOCATION + DATE bar -->
  <div class="relative z-10 mt-24 md:mt-28 px-6 md:px-10 flex items-center justify-between text-white/50 text-[10px] font-bold tracking-[0.25em] uppercase">
    <span>{event.location}</span>
    <span>{event.dates}</span>
  </div>

  <!-- Main content — vertical logo centred, no text logo replacement -->
  <div class="relative z-10 flex-1 flex flex-col items-center justify-center px-6 text-center">

    <!-- Vertical logo (the real brand asset) -->
    <div class="w-48 sm:w-64 md:w-72 mb-10 select-none">
      <img
        src="/images/logos/logo-vertical.svg"
        alt="DADCAMP"
        class="w-full h-auto logo-light"
        draggable="false"
      />
    </div>

    <p class="text-white/70 text-base md:text-lg max-w-sm mx-auto leading-relaxed mb-12 font-light tracking-wide">
      En helg for fedre og barn.<br />Ute i naturen. Uten agenda.
    </p>

    <!-- CTAs — sharp, no rounded corners -->
    <div class="flex flex-col sm:flex-row gap-4">
      <a
        href={spond.url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block bg-white text-forest px-8 py-4 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-cream transition-colors"
      >
        Bli med i Spond →
      </a>
      <a
        href="/#hva"
        class="inline-block border border-white/40 text-white px-8 py-4 text-[11px] font-bold tracking-[0.2em] uppercase hover:border-white/80 transition-colors"
      >
        Les mer ↓
      </a>
    </div>
  </div>

  <!-- Bottom: scroll indicator -->
  <div class="relative z-10 pb-8 flex flex-col items-center gap-2">
    <div class="w-px h-12 bg-white/20"></div>
    <span class="text-white/30 text-[9px] tracking-[0.3em] uppercase">Scroll</span>
  </div>

</section>
