---
import { what } from "../data/content";
---

<section id="hva" class="bg-cream border-t border-forest/10">
  <!-- Top rule with section label -->
  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 pb-2 flex items-center gap-4">
    <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-forest/40">01 — Hva er DADCAMP?</span>
    <div class="flex-1 h-px bg-forest/10"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 grid md:grid-cols-12 gap-0 py-16 md:py-24">

    <!-- Large statement text — editorial feel -->
    <div class="md:col-span-6 md:pr-16">
      <p class="text-[clamp(1.6rem,4vw,2.8rem)] leading-[1.15] font-light text-forest tracking-tight">
        {what.body}
      </p>

      <!-- Highlights — no rounded pills, use ruled lines -->
      <ul class="mt-12 space-y-0 border-t border-forest/15">
        {what.highlights.map((h) => (
          <li class="flex items-center gap-4 py-4 border-b border-forest/15">
            <span class="w-5 h-px bg-ember flex-shrink-0"></span>
            <span class="text-sm font-semibold tracking-wide text-forest">{h}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Photo stack — raw, no border radius -->
    <div class="md:col-span-6 mt-12 md:mt-0 grid grid-cols-2 gap-2">
      <img
        src="/images/camp.jpeg"
        alt="Camping i naturen"
        class="object-cover w-full h-64 col-span-2"
        loading="lazy"
      />
      <img
        src="/images/cooking.jpeg"
        alt="Fedre og barn rundt bålet"
        class="object-cover w-full h-44"
        loading="lazy"
      />
      <img
        src="/images/lantern.jpeg"
        alt="Barn og far med lykt om natten"
        class="object-cover w-full h-44"
        loading="lazy"
      />
    </div>

  </div>
</section>
