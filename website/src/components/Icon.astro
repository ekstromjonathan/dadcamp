---
interface Props {
  name: "tent" | "pot" | "pin";
  class?: string;
}

const { name, class: className = "h-6 w-6" } = Astro.props;

// Multi-path line icons, drawn on a 24×24 grid
const icons: Record<Props["name"], string[]> = {
  tent: [
    "M3.5 20.5 13.4 3.5", // left guy line
    "M20.5 20.5 10.6 3.5", // right guy line
    "M15.7 20.5 12 14.2l-3.7 6.3", // opening
    "M2.4 20.5h19.2", // ground
  ],
  pot: [
    "M5 10.2h14v5.1a4 4 0 0 1-4 4H9a4 4 0 0 1-4-4v-5.1Z", // pot body
    "M5 12.6H2.8M19 12.6h2.2", // handles
    "M10.2 7.4c0-1.3 1.1-1.6 1.1-2.9M14 7.4c0-1.3 1.1-1.6 1.1-2.9", // steam
  ],
  pin: [
    "M12 21.4s6.8-5.8 6.8-10.9a6.8 6.8 0 1 0-13.6 0c0 5.1 6.8 10.9 6.8 10.9Z",
    "M12 13.1a2.6 2.6 0 1 0 0-5.2 2.6 2.6 0 0 0 0 5.2Z",
  ],
};
---

<svg
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  aria-hidden="true"
>
  {icons[name].map((d) => <path d={d} />)}
</svg>
