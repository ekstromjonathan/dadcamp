---
import { practical } from "../data/content";
import SectionHead from "./SectionHead.astro";
import Icon from "./Icon.astro";
---

<section id="praktisk" class="relative bg-cream">
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-cream via-cream to-sand/60"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-20 md:py-28">
    <SectionHead index="03" label="Praktisk" title="Ta med det du trenger." intro={practical.intro} />

    <!-- Cards -->
    <div class="mt-12 grid gap-4 md:mt-16 md:grid-cols-3 md:gap-5">
      {
        practical.sections.map((section, i) => (
          <article class="reveal card group flex flex-col" data-reveal-delay={i * 110}>
            <span class="grid h-12 w-12 place-items-center rounded-2xl bg-ember/10 text-ember transition-colors duration-500 group-hover:bg-ember group-hover:text-cream">
              <Icon name={section.icon as "tent" | "pot" | "pin"} />
            </span>
            <h3 class="mt-6 font-display text-lg font-semibold tracking-tight text-forest">
              {section.title}
            </h3>
            <p class="mt-3 text-[15px] leading-relaxed text-forest/60">{section.body}</p>
          </article>
        ))
      }
    </div>

    <!-- Image duo -->
    <div class="mt-5 grid gap-4 md:mt-6 md:grid-cols-5">
      <figure class="reveal overflow-hidden rounded-3xl shadow-soft md:col-span-3">
        <img
          src="/images/bonfire.png"
          alt="Bål ved vannet"
          class="h-72 w-full object-cover transition-transform duration-[1.2s] ease-out-expo hover:scale-105 md:h-[26rem]"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="reveal relative overflow-hidden rounded-3xl shadow-soft md:col-span-2" data-reveal-delay="110">
        <img
          src="/images/food.gif"
          alt="Matlaging rundt bålet"
          class="h-72 w-full object-cover md:h-[26rem]"
          loading="lazy"
          decoding="async"
        />
        <figcaption
          class="absolute inset-0 flex items-end bg-gradient-to-t from-pine/85 via-pine/10 to-transparent p-7"
        >
          <p class="font-serif text-2xl italic text-cream">der magi skapes</p>
        </figcaption>
      </figure>
    </div>
  </div>
</section>
