---
import { program, event } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section id="program" class="relative overflow-hidden bg-forest text-cream">
  <div class="pointer-events-none absolute inset-0 glow-ember" aria-hidden="true"></div>

  <div class="shell relative py-20 md:py-28">
    <div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
      <SectionHead
        index="02"
        label="Program"
        tone="dark"
        title="Tre dager, én rytme."
        intro={program.note}
      />

      <!-- Big date block -->
      <p
        class="reveal shrink-0 font-display text-[clamp(2.6rem,7vw,4.4rem)] font-light leading-[0.95] tracking-tighter text-white/15 md:text-right"
        data-reveal-delay="80"
      >
        18.–20.<br />sept<br />2026
      </p>
    </div>

    <!-- Timeline -->
    <div class="mt-14 grid gap-4 md:mt-20 md:grid-cols-3 md:gap-5">
      {
        program.days.map((day, di) => (
          <div class="reveal card-dark" data-reveal-delay={di * 110}>
            <header class="flex items-baseline justify-between gap-3 border-b border-white/10 pb-5">
              <h3 class="font-display text-xl font-semibold tracking-tight text-cream">
                {day.day}
              </h3>
              <span class="text-[10px] font-semibold uppercase tracking-label text-amber/70">
                {day.date}
              </span>
            </header>

            <ol class="relative mt-6 space-y-6 pl-5">
              {/* connector line */}
              <span
                class="absolute bottom-2 left-[3px] top-2 w-px bg-gradient-to-b from-amber/40 via-white/15 to-transparent"
                aria-hidden="true"
              />
              {day.items.map((item) => (
                <li class="relative">
                  <span
                    class="absolute -left-5 top-[7px] h-[7px] w-[7px] rounded-full bg-amber/80 ring-4 ring-forest"
                    aria-hidden="true"
                  />
                  <p class="text-[10px] font-semibold uppercase tracking-label text-white/40">
                    {item.time}
                  </p>
                  <p class="mt-1.5 text-sm leading-relaxed text-white/85">{item.text}</p>
                </li>
              ))}
            </ol>
          </div>
        ))
      }
    </div>

    <p class="reveal mt-10 text-[10px] font-semibold uppercase tracking-label text-white/25">
      {event.location} · {event.dates}
    </p>
  </div>
</section>
