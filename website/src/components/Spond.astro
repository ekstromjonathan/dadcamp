---
import { spond } from "../data/content";
---

<!-- Spond — the single most important action on the page -->
<section class="relative overflow-hidden bg-gradient-to-br from-rust via-ember to-amber text-white">
  <div
    class="absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(circle at 20% 20%, #fff 0%, transparent 45%), radial-gradient(circle at 85% 80%, #fff 0%, transparent 40%)"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-14 md:py-20">
    <div class="flex flex-col items-start gap-8 lg:flex-row lg:items-center lg:justify-between lg:gap-14">
      <div class="reveal flex items-start gap-5">
        <img
          src="/images/logos/icon.svg"
          alt=""
          class="logo-light mt-1 hidden w-12 shrink-0 opacity-35 sm:block"
          aria-hidden="true"
        />
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-label text-white/65">
            All kommunikasjon skjer her
          </p>
          <h2 class="mt-3 max-w-2xl text-[clamp(1.4rem,3.2vw,2.15rem)] font-medium leading-tight tracking-tight">
            Bli med i <span class="font-semibold">Spond-gruppa</span> — der finner du
            oppmøtested, oppdateringer og fellesskapet.
          </h2>
        </div>
      </div>

      <a
        href={spond.url}
        target="_blank"
        rel="noopener noreferrer"
        class="reveal btn btn-light shrink-0 shadow-lift !px-8 !py-4"
        data-reveal-delay="120"
      >
        Bli med i Spond <span class="arrow">→</span>
      </a>
    </div>
  </div>
</section>
