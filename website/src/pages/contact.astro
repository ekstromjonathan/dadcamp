---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import { contact, event, spond } from "../data/content";
---

<Layout title="Bli med" description={contact.intro}>
  <Nav />

  <main class="min-h-screen bg-cream pt-32 pb-24">
    <div class="max-w-7xl mx-auto px-6 md:px-10">

      <div class="max-w-2xl">
        <!-- Section label -->
        <p class="text-[10px] font-bold tracking-[0.25em] uppercase text-forest/40 mb-6">
          {event.dates} · {event.location}
        </p>

        <!-- Heading -->
        <h1 class="text-[clamp(2.5rem,6vw,5rem)] font-light leading-tight tracking-tight text-forest mb-6">
          {contact.heading}
        </h1>

        <p class="text-forest/60 text-base md:text-lg leading-relaxed mb-12 max-w-lg">
          {contact.intro}
        </p>

        <!-- Spond primary CTA -->
        <a
          href={contact.spondUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="group inline-flex items-center gap-5 bg-forest text-cream px-10 py-6 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-moss transition-colors mb-12"
        >
          <img src="/images/logos/icon.svg" alt="" class="w-6 h-6 logo-light opacity-70" aria-hidden="true" />
          <span>Bli med i Spond</span>
          <span class="group-hover:translate-x-1 transition-transform">→</span>
        </a>

        <!-- Supporting info -->
        <div class="border-t border-forest/10 pt-8 space-y-4">
          <p class="text-forest/40 text-xs leading-relaxed">
            Spond er gratis å bruke. Der vil du finne all informasjon om oppmøtested, praktiske detaljer og oppdateringer frem mot helgen. Du kan også lese mer om muligheten for å bli betalende støttemedlem.
          </p>
        </div>
      </div>

      <!-- Back link -->
      <div class="mt-16">
        <a href="/" class="text-[10px] font-bold tracking-[0.2em] uppercase text-forest/30 hover:text-forest/60 transition-colors">
          ← Tilbake
        </a>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
