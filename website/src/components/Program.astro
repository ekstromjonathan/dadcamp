---
import { program, event } from "../data/content";
---

<section id="program" class="bg-forest text-cream border-t border-white/10">

  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 pb-2 flex items-center gap-4">
    <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-white/30">02 — Program</span>
    <div class="flex-1 h-px bg-white/10"></div>
    <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-white/30">{event.location}</span>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">

    <div class="grid md:grid-cols-12 gap-16">

      <!-- Big date display -->
      <div class="md:col-span-4 flex flex-col justify-between">
        <div>
          <p class="text-[clamp(3rem,8vw,5rem)] font-light leading-none text-white/20 tracking-tighter">
            1.–3.<br />mai<br />2026
          </p>
        </div>

        {program.note && (
          <p class="mt-8 md:mt-0 text-white/40 text-sm leading-relaxed max-w-xs">
            {program.note}
          </p>
        )}
      </div>

      <!-- Schedule -->
      <div class="md:col-span-8 space-y-10 border-t border-white/10 pt-10 md:pt-0 md:border-t-0">
        {program.days.map((day, i) => (
          <div class="border-t border-white/15 pt-6">
            <h3 class="text-[10px] font-bold tracking-[0.25em] uppercase text-white/40 mb-5">
              {day.day}
            </h3>
            <ul class="space-y-0">
              {day.items.map((item) => (
                <li class="grid grid-cols-[7rem_1fr] gap-4 py-4 border-b border-white/10 last:border-b-0">
                  <span class="text-white/30 text-sm font-mono">{item.time}</span>
                  <span class="text-white/85 text-sm leading-relaxed">{item.text}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>
