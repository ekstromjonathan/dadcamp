---
import { practical } from "../data/content";
---

<section id="praktisk" class="py-24 md:py-32 bg-smoke">
  <div class="max-w-6xl mx-auto px-6">
    <h2 class="font-display font-bold text-4xl md:text-5xl text-forest text-center mb-16">
      {practical.heading}
    </h2>

    <div class="grid md:grid-cols-3 gap-6">
      {practical.sections.map((section) => (
        <div class="bg-cream rounded-3xl p-8">
          <div class="text-4xl mb-5">{section.icon}</div>
          <h3 class="font-display font-bold text-xl text-forest mb-3">
            {section.title}
          </h3>
          <p class="text-forest/70 leading-relaxed text-sm">{section.body}</p>
        </div>
      ))}
    </div>

    <!-- Food GIF callout -->
    <div class="mt-10 rounded-3xl overflow-hidden relative h-64">
      <img
        src="/images/food.gif"
        alt="Matlaging rundt bålet"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-forest/70 to-transparent flex items-end p-8">
        <p class="text-cream font-display text-2xl font-bold">
          Matlaging rundt bålet 🔥
        </p>
      </div>
    </div>
  </div>
</section>
