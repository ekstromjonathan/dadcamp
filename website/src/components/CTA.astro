---
import { cta, event, spond } from "../data/content";
---

<section class="relative overflow-hidden bg-pine text-cream">
  <div class="pointer-events-none absolute inset-0 glow-ember" aria-hidden="true"></div>

  <!-- Oversized watermark icon -->
  <div
    class="pointer-events-none absolute -bottom-16 -right-16 w-[42vw] max-w-lg select-none opacity-[0.05]"
    aria-hidden="true"
  >
    <img src="/images/logos/icon.svg" alt="" class="logo-light w-full" />
  </div>

  <div class="shell relative flex flex-col items-start gap-9 py-24 md:py-36">
    <p class="reveal chip chip-dark">
      {event.location} · {event.dates}
    </p>

    <!-- The full brand lockup: icon, wordmark and slogan as drawn -->
    <div class="reveal w-64 md:w-[22rem]" data-reveal-delay="80">
      <img
        src="/images/logos/slogan.svg"
        alt="DADCAMP — der magi skapes"
        class="logo-light h-auto w-full"
      />
    </div>

    <p class="reveal max-w-md text-[15px] leading-relaxed text-white/50" data-reveal-delay="160">
      {cta.body}
    </p>

    <a
      href={spond.url}
      target="_blank"
      rel="noopener noreferrer"
      class="reveal btn btn-primary mt-2 !px-9 !py-4"
      data-reveal-delay="200"
    >
      {cta.buttonLabel} <span class="arrow">→</span>
    </a>
  </div>
</section>
