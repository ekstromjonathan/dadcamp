---
import { cta, event, spond } from "../data/content";
---

<section class="bg-forest text-cream border-t border-white/10 relative overflow-hidden">

  <!-- Large watermark icon -->
  <div class="absolute right-0 bottom-0 w-[40vw] max-w-lg opacity-[0.04] translate-x-1/4 translate-y-1/4 pointer-events-none select-none" aria-hidden="true">
    <img src="/images/logos/icon.svg" alt="" class="w-full logo-light" />
  </div>

  <div class="relative max-w-7xl mx-auto px-6 md:px-10 py-24 md:py-36 flex flex-col items-start gap-10">

    <!-- Eyebrow -->
    <p class="text-[10px] font-bold tracking-[0.3em] uppercase text-white/30">
      {event.location} · {event.dates}
    </p>

    <!-- DADCAMP wordmark -->
    <div class="w-56 md:w-72">
      <img src="/images/logos/wordmark.svg" alt="DADCAMP" class="w-full h-auto logo-light" />
    </div>

    <!-- Slogan -->
    <p class="text-white/40 text-sm tracking-[0.12em] italic -mt-6">— der magi skapes.</p>

    <!-- CTA -->
    <a
      href={spond.url}
      target="_blank"
      rel="noopener noreferrer"
      class="inline-block bg-white text-forest px-10 py-5 text-[11px] font-bold tracking-[0.2em] uppercase hover:bg-cream transition-colors mt-2"
    >
      {cta.buttonLabel} →
    </a>

  </div>
</section>
