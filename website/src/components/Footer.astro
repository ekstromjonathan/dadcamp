---
import { spond, event } from "../data/content";
---

<footer class="bg-forest border-t border-white/10">
  <div class="max-w-7xl mx-auto px-6 md:px-10 py-10 grid grid-cols-2 md:grid-cols-3 gap-6 items-end">

    <!-- Logo -->
    <a href="/" aria-label="DADCAMP">
      <img
        src="/images/logos/logo-horizontal.svg"
        alt="DADCAMP"
        class="w-32 logo-light opacity-30 hover:opacity-60 transition-opacity"
      />
    </a>

    <!-- Centre info -->
    <p class="text-center text-[10px] text-white/25 tracking-[0.2em] uppercase hidden md:block">
      {event.location} · {event.dates}
    </p>

    <!-- Right -->
    <div class="text-right">
      <a
        href={spond.url}
        target="_blank"
        rel="noopener noreferrer"
        class="text-[10px] font-bold tracking-[0.2em] uppercase text-white/30 hover:text-white/60 transition-colors"
      >
        Spond-gruppa →
      </a>
    </div>

  </div>
</footer>
