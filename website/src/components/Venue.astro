---
import { venue, event } from "../data/content";
import SectionHead from "./SectionHead.astro";

const details = [
  { label: "Sted", value: venue.name },
  { label: "Dato", value: event.dates },
  { label: "Oppmøte", value: venue.meetingPoint, pending: true },
];
---

<section id="sted" class="relative overflow-hidden bg-sand/60">
  <div class="shell relative py-20 md:py-28">
    <SectionHead index="04" label="Sted" />

    <div class="mt-12 grid gap-10 lg:mt-16 lg:grid-cols-12 lg:gap-14">
      <!-- Info -->
      <div class="lg:col-span-5">
        <h2
          class="reveal text-[clamp(1.9rem,4.4vw,3rem)] font-medium leading-[1.08] tracking-tight text-forest"
        >
          {venue.name}
        </h2>

        <dl
          class="reveal mt-9 overflow-hidden rounded-3xl border border-forest/8 bg-white/60 backdrop-blur-sm"
          data-reveal-delay="80"
        >
          {
            details.map((row, i) => (
              <div
                class={`flex flex-col gap-1 px-6 py-5 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6 ${
                  i > 0 ? "border-t border-forest/8" : ""
                }`}
              >
                <dt class="text-[10px] font-semibold uppercase tracking-label text-forest/40">
                  {row.label}
                </dt>
                <dd
                  class={`text-sm sm:text-right ${
                    row.pending ? "italic text-forest/45" : "font-medium text-forest/85"
                  }`}
                >
                  {row.value}
                </dd>
              </div>
            ))
          }
        </dl>

        <p
          class="reveal mt-6 max-w-md text-[15px] leading-relaxed text-forest/55"
          data-reveal-delay="140"
        >
          {venue.note}
        </p>

        <a
          href={venue.mapsUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="reveal btn btn-ghost-light mt-8"
          data-reveal-delay="180"
        >
          Åpne i Google Maps <span class="arrow">→</span>
        </a>
      </div>

      <!-- Map -->
      <div class="reveal lg:col-span-7" data-reveal-delay="120">
        <div
          id="venue-map"
          class="h-80 w-full overflow-hidden rounded-4xl border border-forest/8 bg-sand shadow-lift md:h-[26rem]"
          data-lat={venue.coords[0]}
          data-lng={venue.coords[1]}
          role="img"
          aria-label={`Kart som viser ${venue.name}`}
        >
        </div>
      </div>
    </div>

    <!-- Photo banner -->
    <figure class="reveal relative mt-6 overflow-hidden rounded-4xl shadow-soft">
      <img
        src="/images/location.jpg"
        alt="Naturen rundt leirplassen"
        class="h-64 w-full object-cover md:h-80"
        loading="lazy"
        decoding="async"
      />
      <div
        class="absolute inset-0 bg-gradient-to-t from-pine/75 via-pine/5 to-transparent"
      >
      </div>
      <figcaption
        class="absolute inset-x-0 bottom-0 flex flex-wrap items-center gap-x-3 gap-y-1 p-7"
      >
        <span class="text-[10px] font-semibold uppercase tracking-label text-cream/75">
          {event.location}
        </span>
        <span class="text-cream/25">·</span>
        <span class="text-[10px] font-semibold uppercase tracking-label text-cream/75">
          {event.dateShort} 2026
        </span>
      </figcaption>
    </figure>
  </div>
</section>

<script>
  const el = document.getElementById("venue-map");

  if (el) {
    const lat = Number(el.dataset.lat);
    const lng = Number(el.dataset.lng);

    // Only pull in Leaflet once the map is actually near the viewport
    const load = () => {
      const css = document.createElement("link");
      css.rel = "stylesheet";
      css.href = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.css";
      document.head.appendChild(css);

      const js = document.createElement("script");
      js.src = "https://unpkg.com/leaflet@1.9.4/dist/leaflet.js";
      js.onload = () => {
        // @ts-expect-error — Leaflet is loaded from CDN at runtime
        const L = window.L;

        const map = L.map(el, {
          zoomControl: true,
          scrollWheelZoom: false,
          attributionControl: true,
        }).setView([lat, lng], 12);

        L.tileLayer(
          "https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",
          {
            attribution:
              '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> © <a href="https://carto.com/">CARTO</a>',
            maxZoom: 19,
          }
        ).addTo(map);

        const icon = L.divIcon({
          className: "",
          iconSize: [18, 18],
          iconAnchor: [9, 9],
          html:
            '<span style="display:block;width:18px;height:18px;border-radius:9999px;' +
            "background:#c4622d;border:3px solid #f7f3ea;" +
            'box-shadow:0 0 0 6px rgba(196,98,45,0.22),0 6px 16px rgba(12,20,16,0.3);"></span>',
        });

        L.marker([lat, lng], { icon, keyboard: false }).addTo(map);
      };
      document.head.appendChild(js);
    };

    if ("IntersectionObserver" in window) {
      const io = new IntersectionObserver(
        (entries) => {
          if (entries.some((e) => e.isIntersecting)) {
            io.disconnect();
            load();
          }
        },
        { rootMargin: "300px" }
      );
      io.observe(el);
    } else {
      load();
    }
  }
</script>

<style is:global>
  /* Blend Leaflet chrome into the site's design language */
  #venue-map .leaflet-container {
    background: #ece3d3;
    font-family: "Inter", ui-sans-serif, system-ui, sans-serif;
  }
  /* Keep controls clear of the container's rounded corners */
  #venue-map .leaflet-top,
  #venue-map .leaflet-bottom {
    margin: 10px;
  }
  #venue-map .leaflet-control-zoom {
    border: none !important;
    box-shadow: 0 4px 16px -6px rgba(12, 20, 16, 0.35);
    border-radius: 12px;
    overflow: hidden;
  }
  #venue-map .leaflet-control-zoom a {
    border: none;
    color: #16251b;
    background: rgba(247, 243, 234, 0.94);
  }
  #venue-map .leaflet-control-zoom a:hover {
    background: #fff;
  }
  #venue-map .leaflet-control-attribution {
    background: rgba(247, 243, 234, 0.8);
    font-size: 9px;
    border-radius: 8px 0 0 0;
    padding: 2px 6px;
  }
</style>
