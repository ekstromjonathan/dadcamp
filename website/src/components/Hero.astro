---
import { event, spond } from "../data/content";
---

<section class="relative flex min-h-[100svh] flex-col overflow-hidden bg-pine">
  <!-- Video background -->
  <div class="absolute inset-0">
    <video
      id="hero-video"
      class="h-full w-full scale-105 object-cover"
      autoplay
      muted
      loop
      playsinline
      preload="auto"
      poster="/images/campfire-night.jpeg"
      aria-hidden="true"
    >
      <source src="/video/hero.mp4" type="video/mp4" />
      <source src="/video/hero.webm" type="video/webm" />
    </video>

    <!-- Layered wash: dark top for nav legibility, warm bottom for autumn mood -->
    <div class="absolute inset-0 bg-gradient-to-b from-pine/90 via-pine/50 to-pine/95"></div>
    <!-- Centre vignette keeps the logo and copy readable over any video frame -->
    <div
      class="absolute inset-0"
      style="background-image: radial-gradient(58% 46% at 50% 48%, rgba(12,20,16,0.6) 0%, rgba(12,20,16,0) 78%)"
    >
    </div>
    <div
      class="absolute inset-0 opacity-70"
      style="background-image: radial-gradient(70% 55% at 50% 82%, rgba(196,98,45,0.32) 0%, rgba(196,98,45,0) 72%)"
    >
    </div>
  </div>

  <!-- Main content -->
  <div class="relative z-10 flex flex-1 flex-col items-center justify-center px-5 pb-28 pt-32 text-center">
    <!-- Date + place chip -->
    <div
      class="reveal chip chip-dark mb-10 !border-white/20 !bg-white/[0.07] backdrop-blur-md"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-amber opacity-75"
        ></span>
        <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-amber"></span>
      </span>
      <span class="text-white/80">{event.dateShort} 2026</span>
      <span class="text-white/25">·</span>
      <span class="text-white/80">{event.location}</span>
    </div>

    <!-- Vertical logo -->
    <div class="reveal w-52 select-none sm:w-64 md:w-[19rem]" data-reveal-delay="90">
      <img
        src="/images/logos/logo-vertical.svg"
        alt="DADCAMP"
        class="logo-light h-auto w-full"
        draggable="false"
      />
    </div>

    <p
      class="reveal mt-10 max-w-md text-balance text-lg font-light leading-relaxed tracking-wide text-white/85 md:text-xl"
      style="text-shadow: 0 1px 24px rgba(12,20,16,0.65)"
      data-reveal-delay="180"
    >
      En helg for fedre og barn.<br />
      <span class="font-medium text-amber">Ute i naturen. Uten agenda.</span>
    </p>

    <div class="reveal mt-11 flex w-full max-w-xs flex-col gap-3 sm:max-w-none sm:flex-row sm:justify-center" data-reveal-delay="260">
      <a
        href={spond.url}
        target="_blank"
        rel="noopener noreferrer"
        class="btn btn-primary"
      >
        Bli med i Spond <span class="arrow">→</span>
      </a>
      <a href="/#hva" class="btn btn-ghost-dark backdrop-blur-md">
        Les mer <span class="arrow rotate-90">→</span>
      </a>
    </div>
  </div>

  <!-- Scroll cue -->
  <div class="absolute inset-x-0 bottom-7 z-10 flex flex-col items-center gap-3">
    <div class="relative h-12 w-px overflow-hidden bg-white/15">
      <span class="absolute inset-x-0 top-0 block h-1/2 animate-scroll-cue bg-white/70"></span>
    </div>
    <span class="text-[9px] uppercase tracking-[0.3em] text-white/35">Scroll</span>
  </div>
</section>

<script>
  // Safari needs muted set in JS and sometimes ignores the loop attribute
  const video = document.getElementById("hero-video") as HTMLVideoElement | null;
  if (video) {
    video.muted = true;
    video.play().catch(() => {});
    video.addEventListener("ended", () => {
      video.currentTime = 0;
      video.play().catch(() => {});
    });
  }
</script>
