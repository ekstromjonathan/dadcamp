---
import { spond, event, nav } from "../data/content";

const year = new Date().getFullYear();
---

<footer class="border-t border-white/8 bg-pine">
  <div class="shell py-12">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <!-- Brand -->
      <div>
        <a href="/" aria-label="DADCAMP — til forsiden" class="inline-block">
          <img
            src="/images/logos/logo-horizontal.svg"
            alt="DADCAMP"
            class="logo-light w-32 opacity-40 transition-opacity duration-300 hover:opacity-80"
          />
        </a>
        <p class="mt-4 text-[10px] font-semibold uppercase tracking-label text-white/25">
          {event.location} · {event.dates}
        </p>
      </div>

      <!-- Links -->
      <nav class="flex flex-wrap gap-x-8 gap-y-3" aria-label="Bunnnavigasjon">
        {
          nav.slice(0, -1).map((link) => (
            <a
              href={link.href}
              class="text-[10px] font-semibold uppercase tracking-label text-white/35 transition-colors duration-300 hover:text-white/70"
            >
              {link.label}
            </a>
          ))
        }
        <a
          href={spond.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-[10px] font-semibold uppercase tracking-label text-amber/70 transition-colors duration-300 hover:text-amber"
        >
          Spond-gruppa →
        </a>
      </nav>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-white/8 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-[10px] uppercase tracking-label text-white/20">© {year} DADCAMP</p>
      <p class="text-[10px] uppercase tracking-label text-white/20">— der magi skapes</p>
    </div>
  </div>
</footer>
