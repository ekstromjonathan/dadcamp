---
import { practical } from "../data/content";
---

<section id="praktisk" class="bg-cream border-t border-forest/10">

  <div class="max-w-7xl mx-auto px-6 md:px-10 pt-10 pb-2 flex items-center gap-4">
    <span class="text-[10px] font-bold tracking-[0.25em] uppercase text-forest/40">03 — Praktisk</span>
    <div class="flex-1 h-px bg-forest/10"></div>
  </div>

  <div class="max-w-7xl mx-auto px-6 md:px-10 py-16 md:py-24">

    <!-- Info rows -->
    <div class="border-t border-forest/15">
      {practical.sections.map((section) => (
        <div class="grid grid-cols-[3rem_1fr] md:grid-cols-[4rem_16rem_1fr] gap-x-8 gap-y-2 py-8 border-b border-forest/10 items-start">
          <span class="text-2xl leading-none mt-1">{section.icon}</span>
          <h3 class="text-sm font-bold tracking-wide uppercase text-forest mt-1">{section.title}</h3>
          <p class="col-start-2 md:col-start-3 text-forest/65 leading-relaxed text-sm max-w-prose">
            {section.body}
          </p>
        </div>
      ))}
    </div>

    <!-- Images -->
    <div class="mt-12 grid md:grid-cols-2 gap-2">
      <div class="relative overflow-hidden h-72 md:h-96">
        <img
          src="/images/bonfire.png"
          alt="Bål ved vannet"
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>
      <div class="relative overflow-hidden h-72 md:h-96">
        <img
          src="/images/food.gif"
          alt="Matlaging rundt bålet"
          class="w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-forest/60 to-transparent flex items-end p-6">
          <p class="text-cream text-sm font-bold tracking-widest uppercase">— der magi skapes</p>
        </div>
      </div>
    </div>

  </div>
</section>
