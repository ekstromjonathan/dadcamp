---
import { cta, organizers } from "../data/content";
---

<section class="py-24 md:py-32 bg-cream relative overflow-hidden">
  <!-- Decorative background -->
  <div class="absolute inset-0 flex items-center justify-center pointer-events-none select-none">
    <span class="font-display font-black text-[22rem] text-smoke leading-none">
      DC
    </span>
  </div>

  <div class="relative max-w-3xl mx-auto px-6 text-center">
    <h2 class="font-display font-bold text-5xl md:text-7xl text-forest mb-8 leading-tight">
      {cta.heading}
    </h2>

    <p class="text-forest/70 text-lg md:text-xl leading-relaxed mb-12 max-w-xl mx-auto">
      {cta.body}
    </p>

    <a
      href={cta.buttonUrl}
      class="inline-block bg-ember text-cream px-10 py-5 rounded-full font-semibold text-lg hover:bg-bark transition-colors"
    >
      {cta.buttonLabel} →
    </a>

    <div class="mt-20 text-forest/40">
      <p class="text-sm tracking-[0.3em] uppercase">{organizers.tagline}</p>
      <p class="mt-2 font-display text-xl font-bold text-forest/60">
        {organizers.names}
      </p>
    </div>
  </div>
</section>
