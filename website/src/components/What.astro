---
import { what } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section id="hva" class="relative bg-cream">
  <!-- Soft paper gradient so the section doesn't read as a flat block -->
  <div
    class="pointer-events-none absolute inset-0 bg-gradient-to-b from-sand/50 via-cream to-cream"
    aria-hidden="true"
  >
  </div>

  <div class="shell relative py-20 md:py-28">
    <SectionHead index="01" label="Hva er DADCAMP?" />

    <div class="mt-12 grid gap-12 lg:mt-16 lg:grid-cols-12 lg:gap-16">
      <!-- Statement -->
      <div class="lg:col-span-6">
        <p
          class="reveal text-[clamp(1.55rem,3.6vw,2.55rem)] font-light leading-[1.16] tracking-tight text-forest"
        >
          {what.body}
        </p>

        <p class="reveal mt-7 max-w-md text-lg font-medium leading-snug tracking-tight text-ember md:text-xl" data-reveal-delay="80">
          {what.accent}
        </p>

        <ul class="mt-11 space-y-3">
          {
            what.highlights.map((h, i) => (
              <li
                class="reveal flex items-center gap-4 rounded-2xl border border-forest/8 bg-white/50 px-5 py-4 backdrop-blur-sm"
                data-reveal-delay={100 + i * 90}
              >
                <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-ember/12">
                  <svg viewBox="0 0 12 12" class="h-3 w-3 text-ember" fill="none" aria-hidden="true">
                    <path
                      d="M2 6.4 4.6 9 10 3"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </span>
                <span class="text-sm font-medium tracking-tight text-forest/85">{h}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Photo mosaic -->
      <div class="reveal grid grid-cols-2 gap-3 lg:col-span-6" data-reveal-delay="140">
        <figure class="col-span-2 overflow-hidden rounded-3xl shadow-soft">
          <img
            src="/images/camp.jpeg"
            alt="Leirplassen i skogen"
            class="h-60 w-full object-cover transition-transform duration-[1.2s] ease-out-expo hover:scale-105 md:h-72"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="overflow-hidden rounded-3xl shadow-soft">
          <img
            src="/images/cooking.jpeg"
            alt="Fedre og barn rundt bålet"
            class="h-44 w-full object-cover transition-transform duration-[1.2s] ease-out-expo hover:scale-105 md:h-52"
            loading="lazy"
            decoding="async"
          />
        </figure>
        <figure class="overflow-hidden rounded-3xl shadow-soft">
          <img
            src="/images/lantern.jpeg"
            alt="Barn og far med lykt om natten"
            class="h-44 w-full object-cover transition-transform duration-[1.2s] ease-out-expo hover:scale-105 md:h-52"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>
  </div>
</section>
